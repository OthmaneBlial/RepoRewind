{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepoRewind history archive",
  "description": "Portable structural Git history consumed by the RepoRewind visual history engine.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "contributors", "commits", "releases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "branch", "generatedAt", "firstCommitAt", "lastCommitAt"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "branch": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "scope": { "enum": ["branch", "all-branches"] },
        "truncated": { "type": "boolean" },
        "remote": { "type": "string", "maxLength": 4096 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "firstCommitAt": { "type": "string", "format": "date-time" },
        "lastCommitAt": { "type": "string", "format": "date-time" }
      }
    },
    "contributors": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/contributor" }
    },
    "commits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250000,
      "items": { "$ref": "#/$defs/commit" }
    },
    "releases": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/release" }
    },
    "branches": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/branch" }
    }
  },
  "$defs": {
    "fileChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "additions", "deletions"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "previousPath": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "status": { "enum": ["added", "modified", "deleted", "renamed"] },
        "additions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 },
        "binary": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "renamed" } }, "required": ["status"] },
          "then": { "required": ["previousPath"] }
        }
      ]
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "parents", "authorId", "authoredAt", "message", "additions", "deletions", "files"],
      "properties": {
        "hash": { "type": "string", "minLength": 1, "maxLength": 256 },
        "parents": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "refs": { "type": "array", "items": { "type": "string", "maxLength": 1024 } },
        "isMainline": { "type": "boolean" },
        "isBaseline": { "type": "boolean" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "authoredAt": { "type": "string", "format": "date-time" },
        "message": { "type": "string", "maxLength": 32768 },
        "additions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 },
        "files": { "type": "array", "items": { "$ref": "#/$defs/fileChange" } }
      }
    },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "color", "commits", "additions", "deletions"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "name": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "email": { "type": "string", "maxLength": 320 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "commits": { "type": "integer", "minimum": 0 },
        "additions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commitHash", "date"],
      "properties": {
        "tag": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "commitHash": { "type": "string", "minLength": 1, "maxLength": 256 },
        "date": { "type": "string", "format": "date-time" },
        "message": { "type": "string", "maxLength": 32768 }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tipHash", "color", "isCurrent", "isRemote"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "tipHash": { "type": "string", "minLength": 1, "maxLength": 256 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "isCurrent": { "type": "boolean" },
        "isRemote": { "type": "boolean" }
      }
    }
  }
}
